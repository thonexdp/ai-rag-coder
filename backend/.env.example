# --- Database ---
DATABASE_URL=postgresql://school_user:school_pass@postgres:5432/school_assistant
SQLITE_DATABASE_URL=sqlite:///./school_assistant.db
USE_SQLITE_FOR_DEV=false
POSTGRES_USER=school_user
POSTGRES_PASSWORD=school_pass
POSTGRES_DB=school_assistant

# --- JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- Vector DB (ChromaDB) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=school_documents

# --- App ---
ENV=development
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20
