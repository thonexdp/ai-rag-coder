# Copy this file to backend/.env and fill in real values.
# Never commit the filled-in version.

# --- PostgreSQL ---
POSTGRES_USER=school_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=school_assistant

# --- Dev mode (SQLite instead of Postgres) ---
USE_SQLITE_FOR_DEV=false
SQLITE_DATABASE_URL=sqlite:///./school_assistant.db
PREWARM_EMBEDDING_MODEL=false

# --- LLM / embedding provider: "ollama" or "openai" ---
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=auto

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI (fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

# --- sentence-transformers fallback (optional) ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
ANONYMIZED_TELEMETRY=FALSE
c:\Users\anton\Downloads\files\.env.example c:\Users\anton\Downloads\files\.gitignore c:\Users\anton\Downloads\files\README.md
# --- JWT / auth ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- n8n (docker-compose.n8n.yml) ---
# Use a placeholder locally; set the real ngrok/tunnel URL outside of version control.
N8N_WEBHOOK_URL=https://your-tunnel-url-here.example
